# ============================================================
# local.rules  -  Custom Snort 2.9.x rules for NIDS lab
# Lab network: 192.168.56.0/24
# Place at: /etc/snort/rules/local.rules
# ============================================================

# 1. ICMP ping (reconnaissance)
alert icmp any any -> $HOME_NET any (msg:"LAB ICMP Ping Detected"; itype:8; classtype:attempted-recon; sid:1000001; rev:1;)

# 2. Nmap SYN scan: many SYNs from one source in a short time
alert tcp any any -> $HOME_NET any (msg:"LAB Possible Nmap SYN Port Scan"; flags:S; detection_filter:track by_src, count 20, seconds 5; classtype:attempted-recon; sid:1000002; rev:1;)

# 3. SYN flood (DoS): very high SYN rate to one destination
alert tcp any any -> $HOME_NET any (msg:"LAB Possible SYN Flood DoS"; flags:S; detection_filter:track by_dst, count 200, seconds 3; classtype:attempted-dos; sid:1000003; rev:1;)

# 4. Nmap NULL scan (no flags set)
alert tcp any any -> $HOME_NET any (msg:"LAB Nmap NULL Scan"; flags:0; classtype:attempted-recon; sid:1000004; rev:1;)

# 5. Nmap FIN scan
alert tcp any any -> $HOME_NET any (msg:"LAB Nmap FIN Scan"; flags:F; classtype:attempted-recon; sid:1000005; rev:1;)

# 6. Nmap XMAS scan (FIN+PSH+URG)
alert tcp any any -> $HOME_NET any (msg:"LAB Nmap XMAS Scan"; flags:FPU; classtype:attempted-recon; sid:1000006; rev:1;)

# 7. SSH brute force: repeated new connections to port 22
alert tcp any any -> $HOME_NET 22 (msg:"LAB SSH Brute Force Attempt"; flags:S; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-admin; sid:1000007; rev:1;)

# 8. Directory traversal in HTTP request
alert tcp any any -> $HOME_NET 80 (msg:"LAB HTTP Directory Traversal"; flow:to_server,established; content:"../"; http_uri; classtype:web-application-attack; sid:1000008; rev:1;)

# 9. Access to /etc/passwd via HTTP
alert tcp any any -> $HOME_NET 80 (msg:"LAB HTTP /etc/passwd Access Attempt"; flow:to_server,established; content:"/etc/passwd"; http_uri; classtype:web-application-attack; sid:1000009; rev:1;)

# 10. UDP flood
alert udp any any -> $HOME_NET any (msg:"LAB Possible UDP Flood"; detection_filter:track by_dst, count 200, seconds 3; classtype:attempted-dos; sid:1000010; rev:1;)

# 11. Nmap Scripting Engine user-agent
alert tcp any any -> $HOME_NET 80 (msg:"LAB Nmap NSE HTTP Scan"; flow:to_server,established; content:"Nmap Scripting Engine"; http_header; classtype:attempted-recon; sid:1000011; rev:1;)

# 12. FTP login attempt (cleartext protocol)
alert tcp any any -> $HOME_NET 21 (msg:"LAB FTP USER Login Attempt"; flow:to_server,established; content:"USER "; depth:5; classtype:attempted-user; sid:1000012; rev:1;)
